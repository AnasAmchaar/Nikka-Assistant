# Nikka Environment Configuration
# Copy this file to .env and adjust values as needed.

# LM Studio Endpoint
NIKKA_LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
NIKKA_LM_STUDIO_API_KEY=lm-studio
NIKKA_LM_STUDIO_MODEL_ID=openai/google/gemma-3-12b

# Agent Tuning
NIKKA_MAX_AGENT_STEPS=12
NIKKA_VERBOSITY=2

# UI Parser Settings
NIKKA_UI_PARSE_DEPTH=40
NIKKA_UI_MAX_ELEMENTS=80
NIKKA_APP_LAUNCH_WAIT_SEC=3.0

# Spotify Web API (https://developer.spotify.com/dashboard)
NIKKA_SPOTIFY_CLIENT_ID=your_client_id_here
NIKKA_SPOTIFY_CLIENT_SECRET=your_client_secret_here
NIKKA_SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
